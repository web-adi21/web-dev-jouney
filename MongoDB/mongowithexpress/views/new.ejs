<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Chat</title>
</head>
<body>
  <h2>Write new chat</h2>
  <form method="post" action="/chats">
    <h4><input type="text" placeholder="Sender" name="from"></h4>
    <h4><input type="text" placeholder="Receiver" name="to"></h4>
    <h4><input type="text" placeholder="Message" name="message" style="height: 100px; width: 20%;"></h4>
    <button>submit</button>
  </form>
</body>
</html>
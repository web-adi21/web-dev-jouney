<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>USERS</title>
</head>
<body>
  <h1>USERS</h1>
  <%for(let i =0;i<data.length;i++) {%>
    <h3><%= i+1 %></h3>
      <p>
        ID: <%=data[i]['id']%>
      </p>
      <p>
        USERNAME: <%=data[i]['username']%>
      </p>
      <p>
        Email address: <%=data[i]['email']%>
      </p>
    <form method="GET" action = "/users/<%=data[i]['id']%>/edit">
      <button>Edit</button>
    </form>
    <form method="post" action = "/users/<%=data[i]['id']%>/edit">
      <button>Edit</button>
    </form>
    <br>
    <br>
    <%}%>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>edit</title>
</head>
<body>
  <h2>Edit Credentials</h2>
  <form method="post" action="/user/<%=selectedUser[0].id%>?_method=PATCH">
      <h3>Username</h3>
    <input type="text" placeholder="<%=selectedUser[0].username%>" name="newUsername">

    <h3>Email</h3>
    <input type="text" placeholder="<%=selectedUser[0].email%>" name="newEmail">

    <h3>Password</h3>
    <input type="text" placeholder="Old Password" name="enteredPassword">

    <button>Submit</button>
  </form>
  
</body> 
</html>
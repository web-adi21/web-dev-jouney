<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Instagram</title>
  <style>
    .img {
      height: 70px;
      width: 70px;
    }
  </style>
</head>
<body>
  
<div class="header-div">

</div>



<div class="body-div">
<%=for(thing of posts) {%>
<div class="container-div">
  <div class="headingdiv"><<h2 class="username"><%=thing.username%></h2></div>
  <div class="imagediv"><img class="img" src="<%=thing.image%>"></div>
  <div class="statsdiv">
    <h6 class="likes"><%=thing.likes%></h6>
    <h6 class="comments"><%=thing.comments%></h6>
  </div>
  
</div> 
<%=}%>
</div>

</body>
</html>
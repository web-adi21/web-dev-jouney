<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All posts</title>
</head>
<body>
  <h1>Quora Posts</h1>
  <% for(thing of posts) { %>
    <div>
      <h3>@ <%= thing.username %></h3>
      <h4> <%= thing.content %> </h4>
    </div>
  <%}%>
</body>
</html>